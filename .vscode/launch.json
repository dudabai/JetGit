{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Tauri: Debug Frontend (Chrome)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:1420",
			"webRoot": "${workspaceFolder}/apps/desktop/src",
			"sourceMapPathOverrides": {
				"webpack:///./src/*": "${webRoot}/*"
			}
		},
		{
			"name": "Tauri: Debug Frontend (Edge)",
			"type": "msedge",
			"request": "launch",
			"url": "http://localhost:1420",
			"webRoot": "${workspaceFolder}/apps/desktop/src"
		},
		{
			"name": "Tauri: Attach Rust (CodeLLDB)",
			"type": "lldb",
			"request": "attach",
			"program": "${workspaceFolder}/target/debug/gitbutler-tauri",
			"pid": "${command:pickProcess}",
			"stopOnEntry": false
		}
	],
	"compounds": [
		{
			"name": "Tauri: Full Debug (Rust + Chrome)",
			"configurations": ["Tauri: Debug Frontend (Chrome)", "Tauri: Attach Rust (CodeLLDB)"],
			"stopAll": true
		}
	]
}
